{
  "name": "fitness-habit-tracker",
  "version": "3.3.1",
  "private": true,
  "browserslist": [
    "chrome 85"
  ],
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.3.5",
    "prisma": "^5.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  },
  "scripts": {
    "seed": "npx prisma db seed",
    "build": "prisma generate && next build",
    "dev": "next dev",
    "lint": "eslint",
    "test:smoke": "node --test tests/api-smoke.test.mjs",
    "test:ingress": "node --test tests/ingress-proxy.test.mjs",
    "test:database": "node --test tests/database-integrity.test.mjs",
    "test:browser-compat": "node --test tests/browser-compat.test.mjs",
    "test:ui": "playwright test",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "db:init": "npx prisma migrate dev --name init && npm run seed",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "start": "next start"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
